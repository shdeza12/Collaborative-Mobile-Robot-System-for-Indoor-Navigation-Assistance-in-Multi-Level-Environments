# Artefactos de compilación de colcon/ROS 2
build/
install/
log/

# Caché Python
__pycache__/
*.pyc
.pytest_cache/

# Editores
.vscode/
.idea/
*.swp
*~
# Candados de LibreOffice: existen solo mientras el .csv está abierto y
# desaparecen al cerrarlo. Versionarlos haría creer que el archivo está en uso.
.~lock.*#

# Configuración local del asistente: es del equipo, no del proyecto.
.claude/

# Sistema
.DS_Store
Thumbs.db

# Bags de ROS 2 — basura de trabajo, no evidencia
#
# De una corrida se conserva el registro JSON que compone
# `herramientas/componer_registro.py`, no el bag del que salió. Ningún bag ha
# estado nunca versionado y los guiones los graban a /tmp o al destino que se
# les pase. Los `mapas/bag_mapa_*` son restos de corridas de mapeo; el mapa que
# sí cuenta (`mapa_laboratorio.pgm` y su `.yaml`) está versionado al lado.
*.mcap
*.db3
mapas/bag_mapa_*/

# Videos de las pruebas — no se versionan
#
# Un video de un minuto pesa decenas de MB, y git lo conserva para siempre aunque se borre
# despues. Va en la carpeta compartida del equipo; en el informe, un fotograma y el enlace.
# Convencion en Documentos/Evidencia/README.md, «Fotos de campo y videos».
*.mp4
*.mov
*.webm
*.mkv

# Videos de campo y su edición (originales, proyecto de Shotcut y exportaciones): no se versionan.
VIDEOS/

# Sitio construido por MkDocs (se genera con mkdocs build; no se versiona)
.sitio_construido/
