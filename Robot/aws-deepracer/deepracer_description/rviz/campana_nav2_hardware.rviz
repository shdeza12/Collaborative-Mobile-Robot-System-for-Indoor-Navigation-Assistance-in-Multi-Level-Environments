# Vista de una corrida de campana del vehiculo REAL, reproducida desde su bag.
# La usa herramientas/ver_bag_rviz.sh. Los topicos son los del carro, sin
# espacio de nombres: el LiDAR de fabrica publica en /rplidar_ros/scan.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time
Visualization Manager:
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Rejilla 1 m
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Color: 90; 90; 90
    - Class: rviz_default_plugins/Map
      Name: Mapa
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.8
    - Class: rviz_default_plugins/LaserScan
      Name: Barrido LiDAR
      Enabled: true
      Topic:
        Value: /rplidar_ros/scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 4
      Color Transformer: FlatColor
      Color: 255; 60; 60
      Decay Time: 0
    - Class: rviz_default_plugins/Path
      Name: Plan de Nav2
      Enabled: true
      Topic:
        Value: /plan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 60; 220; 60
      Line Style: Billboards
      Line Width: 0.04
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: Pose de AMCL
      Enabled: true
      Topic:
        Value: /amcl_pose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Shape: Arrow
      Color: 60; 140; 255
      Covariance:
        Value: true
        Position:
          Value: true
          Alpha: 0.3
          Color: 60; 140; 255
          Scale: 1
    - Class: rviz_default_plugins/Odometry
      Name: Rastro de /odom
      Enabled: true
      Topic:
        Value: /odom
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Keep: 400
      Shape:
        Value: Arrow
        Shaft Length: 0.12
        Shaft Radius: 0.015
        Head Length: 0.05
        Head Radius: 0.03
        Color: 255; 200; 0
      Covariance:
        Value: false
    - Class: rviz_default_plugins/TF
      Name: Marcos
      Enabled: true
      Show Names: true
      Show Axes: true
      Marker Scale: 0.4
  # Vista cenital ortografica: en un pasillo recto es la que deja leer
  # distancias. La perspectiva por defecto de RViz las deforma.
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 110
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
      X: 3
      Y: 0
      Angle: 0
    Saved: ~
# Disposicion de paneles copiada de nav2_robot1_view.rviz: sin ella RViz
# reparte la ventana a partes iguales y el panel de capas se come la vista.
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: true
  Width: 1500
  X: 0
  Y: 0
