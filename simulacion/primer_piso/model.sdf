    <!-- Descanso de escalera. Marca visible SIN <collision> a proposito: ningun
         vehiculo sube, es el punto donde robot1 y robot2 se relevan. Al no tener
         colision no estorba la navegacion ni sale como obstaculo en el mapa
         (ver herramientas/generar_mapa_desde_mundo.py, que solo lee colisiones).
         Pose relativa al modelo; en el mundo cae en (41.40, 3.03), en el recinto
         terminal del extremo este. Como el modelo se instancia en los dos
         niveles, la marca queda en las mismas x-y arriba y abajo. -->
    <link name='zona_transicion'>
      <pose>20.4964 1.59437 0.01 0 0 0</pose>
      <visual name='zona_transicion_visual'>
        <geometry>
          <box>
            <size>1.5 1.5 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.4 0.1 1</ambient>
          <diffuse>0.9 0.4 0.1 1</diffuse>
        </material>
      </visual>
    </link>
    <static>1</static>
