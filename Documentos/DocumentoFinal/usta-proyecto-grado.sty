% --------------------------------------------------- nota de aceptación ---
% Toda la hoja va CENTRADA: el titulo, el bloque de rayas y las firmas. Antes
% iba alineada a la derecha, que es como la trae la plantilla de Word, pero ahi
% queda descolgada del resto del documento.
\newcommand{\ustanotaaceptacion}{%
  \clearpage
  \begin{center}
  {\bfseries\large Nota de aceptación:\par}
  \vspace{1cm}
  \begin{minipage}{0.62\textwidth}
    \rule{\linewidth}{0.4pt}\\[0.9cm]
    \rule{\linewidth}{0.4pt}\\[0.9cm]
    \rule{\linewidth}{0.4pt}\\[0.9cm]
    \rule{\linewidth}{0.4pt}\\[2cm]
    \rule{\linewidth}{0.4pt}\\ \centering Firma del Director\\[1.2cm]
    % La plantilla trae aqui una raya para el codirector. Se quita: el proyecto
    % no tuvo codirector, y una firma que nadie va a estampar no debe aparecer.
    % Si llegara a nombrarse uno, se devuelve esta linea y se rellena
    % \ustacodirector en main.tex, que es lo que imprime su nombre en la
    % contraportada.
    \rule{\linewidth}{0.4pt}\\ \centering Firma del Jurado 1\\[1.2cm]
    \rule{\linewidth}{0.4pt}\\ \centering Firma del Jurado 2
  \end{minipage}
  \vfill
  Bogotá D.C., Colombia\\ \@ustames\ de \@ustaanio
  \end{center}
  \clearpage}

% ------------------------------------------------------------ advertencia ---
