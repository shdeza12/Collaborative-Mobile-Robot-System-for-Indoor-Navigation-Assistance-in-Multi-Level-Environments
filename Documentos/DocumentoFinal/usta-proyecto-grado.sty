% -------------------------------------------- sección de preliminares ---
% Título de primer nivel SIN numerar y que sí entra en el índice.
\newcommand{\ustaseccion}[1]{%
  \clearpage
  \phantomsection
  \addcontentsline{toc}{chapter}{#1}%
  {\centering\bfseries\large\MakeUppercase{#1}\par}
  \vspace{1em}}

% -------------------------------------------------- notas al revisor ---
% Bloque visible para marcar lo que está pendiente o a discusión en una
% revisión. NO es texto final: se quita antes de entregar poniendo
% \ustanotasrevisorfalse en el preámbulo.
\RequirePackage{mdframed}
\newif\ifustanotasrevisor
\ustanotasrevisortrue
\newenvironment{notarevisor}{%
  \ifustanotasrevisor
    \begin{mdframed}[linewidth=0.6pt,linecolor=gray,backgroundcolor=black!4,
                     innertopmargin=6pt,innerbottommargin=6pt]%
    \small\textbf{Nota para la revisión.}\par\vspace{-0.4em}%
  \else \expandafter\comment \fi}%
 {\ifustanotasrevisor\end{mdframed}\else\expandafter\endcomment\fi}
\RequirePackage{verbatim}

% ------------------------------------------------- notas de estado de avance ---
% Distinto de \begin{notarevisor}, y conviene no confundirlos:
%
%   notarevisor  = algo que el equipo pregunta AL DIRECTOR y se borra al
%                  resolverse. No es texto del documento.
%   notaavance   = aviso al LECTOR de que ese apartado esta abierto porque la
%                  toma de datos no ha cerrado. Si es texto del documento,
%                  mientras el proyecto siga en curso.
%
% Se declara con su propio interruptor para poder quitarlas todas de golpe
% cuando el proyecto cierre: \ustanotasavancefalse en el preambulo.
\newif\ifustanotasavance
\ustanotasavancetrue
\newenvironment{notaavance}[1][]{%
  \ifustanotasavance
    \begin{mdframed}[linewidth=2pt,linecolor=black!45,backgroundcolor=white,
                     leftline=true,rightline=false,topline=false,bottomline=false,
                     innerleftmargin=12pt,innertopmargin=4pt,innerbottommargin=4pt]%
    \small\textbf{Apartado en curso\ifx\relax#1\relax\else: #1\fi.}\par\vspace{-0.4em}%
  \else \expandafter\comment \fi}%
 {\ifustanotasavance\end{mdframed}\else\expandafter\endcomment\fi}

% ------------------------------------------------ listas sin doble título ---
% Por omisión \tableofcontents y sus hermanas emiten su propio \chapter*, así
% que puestas detrás de \ustaseccion saldría el encabezado DOS veces: el de
% \ustaseccion y el de la lista. Se despojan de su título y se quedan solo con
% las entradas; el encabezado, centrado y en mayúsculas como pide la plantilla,
% lo pone \ustaseccion.
%
% '\@starttoc{xxx}' es el mecanismo interno que lee el .toc/.lof/.lot y lo
% vuelca. Es lo mismo que hacen las macros originales, menos el título.
% El \parskip de 0,8em que el cuerpo necesita separa también las entradas del
% índice, y deja un CONTENIDO con las líneas a media página de distancia. Se
% anula dentro de las listas, que llevan su propio espaciado.
\makeatletter
% Referencias en la misma hoja en que termina el capítulo anterior.
\newcommand{\ustaseccioncontinua}[1]{\par\addvspace{2.2em}%
  \let\usta@cp\clearpage\let\clearpage\relax\ustaseccion{#1}\let\clearpage\usta@cp}
% Capítulos sin número que siguen en la misma hoja: trabajos futuros y anexos cortos
% no dejan una hoja casi vacía.
\newcommand{\ustacapitulocontinuo}[1]{\par\addvspace{2.2em}%
  \let\usta@cp\clearpage\let\clearpage\relax\chapter*{#1}\let\clearpage\usta@cp}
\newcommand{\usta@lista}[1]{\begingroup
  \setlength{\parskip}{0pt}\setstretch{1.1}\@starttoc{#1}\endgroup}
\renewcommand{\tableofcontents}{\usta@lista{toc}}
\renewcommand{\listoffigures}{\usta@lista{lof}}
\renewcommand{\listoftables}{\usta@lista{lot}}
\renewcommand{\listofgraficas}{\usta@lista{lodg}}   % el tipo flotante propio
\renewcommand{\lstlistoflistings}{\usta@lista{lol}}
\makeatother

\endinput
