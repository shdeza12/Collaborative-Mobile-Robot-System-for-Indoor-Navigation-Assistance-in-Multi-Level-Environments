  GRABA, y despues manda la meta:
    ssh deepracer@192.168.0.104 "sudo -n bash -c 'export ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST; [ -f /etc/deepracer-tesis/particion.xml ] && export FASTRTPS_DEFAULT_PROFILES_FILE=/etc/deepracer-tesis/particion.xml; source /opt/ros/jazzy/setup.bash && source /home/deepracer/nav_ws/install/setup.bash && cd ~deepracer && timeout -s INT 150 ros2 bag record -s mcap -o nav2_usta_01 /rplidar_ros/scan /robot2/odom /robot2/cmd_vel /tf /tf_static /robot2/plan /robot2/map /robot2/amcl_pose; chown -R deepracer:deepracer ~deepracer/nav2_usta_01'"

  LA META (el script NO la manda: la mandas tu mirando el carro):
    ssh deepracer@192.168.0.104 "sudo -n bash -c 'export ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST; [ -f /etc/deepracer-tesis/particion.xml ] && export FASTRTPS_DEFAULT_PROFILES_FILE=/etc/deepracer-tesis/particion.xml; source /opt/ros/jazzy/setup.bash && source /home/deepracer/nav_ws/install/setup.bash && ros2 action send_goal --feedback /robot2/navigate_to_pose nav2_msgs/action/NavigateToPose \"{pose: {header: {frame_id: robot2/map}, pose: {position: {x: 6.0, y: 0.0, z: 0.0}, orientation: {w: 1.0}}}}\"'"

